# StayO backend — environment variable reference
#
# Loaded from the repo root (apps/backend reads `../../.env` via
# DOTENV_CONFIG_PATH — see CLAUDE.md). Copy this file to `.env` for local
# dev; on Vercel, set these in each project's Environment Variables
# dashboard instead of committing a real .env file.
#
# Column key used in each section header:
#   [Shared]           — same value can be reused across Production and Staging
#   [Per-environment]  — MUST differ between Production and Staging (isolation)
#   [Required]         — app fails to start / fails loudly without it
#   [Optional]         — has a safe default, or only matters for a specific feature
#
# See lib/config/domains.ts for how FRONTEND_URL/BACKEND_URL resolution
# works, and the "Production/Staging Split" architecture review for the
# full reasoning behind the [Per-environment] split.

# ============================================================
# Database — Supabase Postgres [Per-environment] [Required]
# ============================================================
# Pooled connection (PgBouncer/Supavisor) — used by the app at runtime.
DATABASE_URL=
# Direct connection (no pooler) — used for migrations and the DB backup workflow.
DIRECT_URL=
# Separate throwaway test database. Required whenever NODE_ENV=test — the
# app refuses to start otherwise, specifically to prevent an accidental
# test run against a real database.
DATABASE_URL_TEST=

# ============================================================
# Supabase Auth [Per-environment] [Required]
# ============================================================
# Each Supabase project has its own Auth/JWKS endpoint — Staging and
# Production must NOT share a project, or their sessions become
# interchangeable.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ============================================================
# Frontend/Backend URLs — CORS, redirects, outbound links [Per-environment] [Required on Vercel]
# ============================================================
# The frontend's own origin. Required on every Vercel deployment (Preview/
# Staging included) — as of the staging-separation refactor, a non-production
# Vercel deployment throws at runtime if this is unset rather than silently
# falling back to the production URL. Only local/non-Vercel runs still fall
# back to the production default.
FRONTEND_URL=
NEXT_PUBLIC_FRONTEND_URL=
# The backend's own origin, used for building outbound links (activation,
# password reset, payment links, receipt verification) and cron self-calls.
# Same fail-loud rule as FRONTEND_URL above.
BACKEND_URL=
NEXT_PUBLIC_APP_URL=
NEXT_PUBLIC_API_URL=
API_URL=
# Comma-separated list of extra origins the backend should accept CORS
# requests from, beyond FRONTEND_URL itself. On Staging this is where the
# Staging frontend's exact origin must be listed if it differs from
# FRONTEND_URL.
CORS_ALLOWED_ORIGINS=
LEGACY_FRONTEND_ORIGINS=
# [Optional] Only needed if Staging and Production ever share an apex
# domain (e.g. staging.yourstayo.com) — pins the CSRF cookie to a specific
# host so Staging's cookie can't be read as valid on Production.
COOKIE_DOMAIN=
# [Optional] Google OAuth redirect URI override — defaults to
# `${FRONTEND_URL}/callback` if unset.
GOOGLE_REDIRECT_URI=

# ============================================================
# Auth/session secrets [Per-environment] [Required]
# ============================================================
# Used outside the Supabase session itself: SSE short-lived tokens, receipt
# verification tokens, the identity-confirmation step-up flow,
# password-reset tokens. Generate a unique, random value per environment —
# never reuse Production's.
JWT_SECRET=
# HMAC secret for tenant receipt-verification links.
RECEIPT_VERIFY_SECRET=

# ============================================================
# Cron authentication [Per-environment] [Required]
# ============================================================
# Bearer-token auth for every /api/cron/* route. MUST differ between
# environments — Staging must never be able to trigger a Production cron
# job (or vice versa) with a shared secret.
CRON_SECRET=

# ============================================================
# Payments — Razorpay [Per-environment] [Required]
# ============================================================
# Razorpay supports separate test-mode and live-mode key pairs natively —
# use test-mode keys for Staging, never live keys.
PAYMENT_PROVIDER=RAZORPAY
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# [Optional] Only needed if pointing at something other than Razorpay's
# standard API host.
RAZORPAY_BASE_URL=

# ============================================================
# WhatsApp Cloud API (Meta) [Per-environment — see note] [Required for WhatsApp features]
# ============================================================
# DECISION NEEDED before Staging goes live: share Production's WABA/number
# (risk: Staging can send real WhatsApp messages to real tenants) or
# provision a second WABA for Staging. See the architecture review for the
# full tradeoff — recommendation is a second WABA.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
META_APP_ID=
# Verifies Meta's webhook handshake + payload signature — must match what's
# registered in the Meta dashboard for this environment's webhook URL.
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
META_APP_SECRET=
# [Optional] overrides — sane defaults exist in code.
WHATSAPP_API=
WHATSAPP_TIMEOUT_MS=
WHATSAPP_MAX_RETRIES=
# Approved template names — only meaningful if Staging has its own WABA with
# its own template approvals; otherwise these must match Production's exact
# approved template names.
WHATSAPP_OTP_TEMPLATE=
WHATSAPP_INVITATION_TEMPLATE=
WHATSAPP_INVITATION_LANGUAGE=
WHATSAPP_ONBOARDING_TEMPLATE=
WHATSAPP_ONBOARDING_LANGUAGE=
WHATSAPP_OWNER_ACTIVATION_TEMPLATE=
WHATSAPP_OWNER_ACTIVATION_LANGUAGE=
WHATSAPP_OWNER_WELCOME_TEMPLATE=
WHATSAPP_OWNER_WELCOME_LANGUAGE=
# Owner-acquisition funnel WhatsApp templates (added 2026-08-06). Defaults
# are the stayo_owner_* names below; override only if Meta forces a rename
# during template review. As of this writing only
# WHATSAPP_OWNER_LEAD_RECEIVED_TEMPLATE's default is approved in Meta — the
# other four sends will fail until their templates clear review. See
# docs/obsidian/Business-Rules.md "Owner-acquisition funnel notifications".
WHATSAPP_OWNER_LEAD_RECEIVED_TEMPLATE=stayo_owner_lead_received
WHATSAPP_OWNER_INVITATION_TEMPLATE=stayo_owner_invitation
WHATSAPP_OWNER_ACCOUNT_ACTIVATED_TEMPLATE=stayo_owner_account_activated
WHATSAPP_OWNER_ONBOARDING_COMPLETE_TEMPLATE=stayo_owner_onboarding_complete
WHATSAPP_OWNER_LEAD_REJECTED_TEMPLATE=stayo_owner_lead_rejected
# [Optional] which channel sends OTPs — "whatsapp" activates the WhatsApp
# OTP path; see lib/services/auth/phone-verification-mode.ts.
OTP_PROVIDER=
PHONE_VERIFICATION_MODE=

# ============================================================
# Email — Resend [Shared or per-environment — your call] [Required]
# ============================================================
# No sandbox/live distinction the way payment providers have one. Sharing
# is low-risk but Staging test emails will come from the same sender
# identity as Production unless EMAIL_FROM differs.
RESEND_API_KEY=
EMAIL_FROM="StayO <admin@yourstayo.com>"

# ============================================================
# File storage — ImageKit [Shared or per-environment — your call] [Required]
# ============================================================
# Stored URLs are persisted as full absolute URLs in the database. If
# Staging is ever seeded from a Production snapshot and uses a *different*
# ImageKit account than Production, old rows' media URLs may not resolve
# correctly for private-file/signed-URL flows. Sharing one account avoids
# that at the cost of mixing Staging's test uploads into Production's
# media library.
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_URL_ENDPOINT=

# ============================================================
# Redis — Upstash [Per-environment recommended] [Optional]
# ============================================================
# Purely an acceleration layer — every call has a direct-DB-read fallback
# (see lib/redis/client.ts safeRedis()). A separate Upstash database per
# environment is recommended (free tier, avoids Staging polluting
# Production's rate-limit/session state); REDIS_KEY_PREFIX exists if you'd
# rather share one instance with namespaced keys instead.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
REDIS_ENABLED=true
REDIS_KEY_PREFIX=hms
RESIDENT_CONTEXT_TTL_SECONDS=

# ============================================================
# Sanity CMS [Shared] [Optional]
# ============================================================
# Marketing/legal content — no reason for this to differ between
# environments unless you want a separate content dataset for testing.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=

# ============================================================
# Operational / ops-script-only [Optional] — not read by the running app
# ============================================================
ALLOW_OWNER_BOOTSTRAP=
HMS_FINANCIAL_OWNER_ID=
PRIMARY_OWNER_ID=
PRODUCTION_OWNER_ID=
RENT_CRON_OWNER_ID=
RENT_CRON_BATCH_SIZE=
SANITY_REVALIDATE_SECRET=

# ============================================================
# Auto-provided by Vercel — do not set manually
# ============================================================
# VERCEL_ENV is set by Vercel itself: "production" for the Production
# deployment, "preview" for every Preview/Staging deployment. This is what
# lib/config/domains.ts uses to tell Staging apart from Production — do not
# override it.
# VERCEL_ENV=
# NODE_ENV=
