enum AgreementTemplateType {
  RESIDENCY
  RENEWAL
  MOVE_OUT
}

enum TemplateStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum AgreementStatus {
  DRAFT
  SIGNED
  EXPIRING_SOON
  AGREEMENT_EXPIRED
  RENEWED
  TERMINATED
  VOID
}

enum RenewalOfferStatus {
  DRAFT
  SENT
  ACCEPTED
  DECLINED
  EXPIRED
  REVISED
  SUPERSEDED
}

model AgreementTemplate {
  id                  String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  hostel_id           String                @db.Uuid
  version             String                // e.g. "2026-v1"
  title               String                @default("Standard Tenant Agreement")
  custom_rules        String?               // Optional custom rules or additions
  owner_name          String                // Owner/Authorized Signatory Name
  owner_signature_url String?               // URL to signature stamp image (Supabase Storage)
  is_active           Boolean               @default(true)
  created_at          DateTime              @default(now()) @db.Timestamptz(6)
  updated_at          DateTime?             @db.Timestamptz(6)
  rules_content       Json?                 // JSON storing the parsed categories (highlights and rules)
  
  type                AgreementTemplateType @default(RESIDENCY)
  status              TemplateStatus        @default(DRAFT)
  version_number      Int                   @default(1)
  effective_from      DateTime              @default(now()) @db.Timestamptz(6)
  effective_to        DateTime?             @db.Timestamptz(6)
  published_at        DateTime?             @db.Timestamptz(6)
  published_by_id     String?               @db.Uuid

  // Default values for room categories and templates
  room_category             String?
  default_rent              Decimal?              @db.Decimal(10, 2)
  default_security_deposit  Decimal?              @db.Decimal(10, 2)
  default_duration_months   Int?
  notice_period_days        Int?

  hostel              hostels               @relation(fields: [hostel_id], references: [id], onDelete: Cascade)
  agreements          Agreement[]
  published_by        profile?              @relation("TemplatePublisher", fields: [published_by_id], references: [id])

  @@unique([hostel_id, version])
  @@index([hostel_id])
}

model Agreement {
  id                      String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  version                 Int             @default(1)
  tenant_id               String          @db.Uuid
  hostel_id               String          @db.Uuid
  template_id             String          @db.Uuid
  renewed_from_agreement_id String?       @db.Uuid
  renewed_to_agreement_id String?         @db.Uuid
  status                  AgreementStatus @default(DRAFT)
  content_snapshot        Json            // Resolved snapshot of everything (hostel, rent, deposit, joining date, tenant info, custom rules)
  pdf_url                 String?         // URL to stored PDF document in Supabase
  rules_snapshot          Json?
  rule_version_id         String?           @db.Uuid
  rule_version_number     String?
  agreement_version       Int             @default(1)
  agreement_start_date    DateTime?       @db.Date
  agreement_end_date      DateTime?       @db.Date
  agreement_duration_months Int?
  contract_rent           Decimal?        @db.Decimal(10, 2)
  contract_security_deposit Decimal?      @db.Decimal(10, 2)
  contract_maintenance    Decimal?        @db.Decimal(10, 2)
  contract_maintenance_type String?
  contract_payment_frequency PaymentFrequency?
  
  generated_at            DateTime        @default(now()) @db.Timestamptz(6)
  signed_at               DateTime?       @db.Timestamptz(6)
  voided_at               DateTime?       @db.Timestamptz(6)
  expiry_notified_30d_at  DateTime?       @db.Timestamptz(6)
  expiry_notified_15d_at  DateTime?       @db.Timestamptz(6)
  expired_notified_at     DateTime?       @db.Timestamptz(6)
  terminated_at           DateTime?       @db.Timestamptz(6)
  renewed_at              DateTime?       @db.Timestamptz(6)

  // Tenant / Student signature info
  tenant_signature_url    String?         // Signature image PNG URL
  tenant_signature_name   String?
  tenant_signed_at        DateTime?       @db.Timestamptz(6)
  tenant_ip               String?
  tenant_user_agent       String?

  // Parent / Guardian signature info
  guardian_signature_url  String?         // Signature image PNG URL
  guardian_signature_name String?
  guardian_relation       String?         // Relationship (Father, Mother, Guardian, Other)
  guardian_signed_at      DateTime?       @db.Timestamptz(6)
  guardian_ip             String?
  guardian_user_agent     String?

  // Owner signature info (copied from template at time of signing)
  owner_signature_url     String?
  owner_signature_name    String?
  owner_signed_at         DateTime?       @db.Timestamptz(6)

  tenant                  tenants           @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  hostel                  hostels           @relation(fields: [hostel_id], references: [id], onDelete: Cascade)
  template                AgreementTemplate @relation(fields: [template_id], references: [id])
  renewed_from_agreement  Agreement?        @relation("AgreementRenewedFrom", fields: [renewed_from_agreement_id], references: [id])
  renewed_agreements      Agreement[]       @relation("AgreementRenewedFrom")
  renewed_to_agreement    Agreement?        @relation("AgreementRenewedTo", fields: [renewed_to_agreement_id], references: [id])
  renewed_previous_agreements Agreement[]   @relation("AgreementRenewedTo")
  rent_obligations        rent_obligations[]
  renewal_offers_source   RenewalOffer[]   @relation("OfferSourceAgreement")
  renewal_offers_result   RenewalOffer[]   @relation("OfferResultAgreement")
  renewal_timeline_events RenewalTimelineEvent[]

  @@index([tenant_id])
  @@index([tenant_id, status])
  @@index([hostel_id])
  @@index([hostel_id, status, agreement_end_date])
  @@index([status, agreement_end_date])
  @@index([status])
  // Amendment traceability (Change Management System)
  amendment_reason         String?
  change_request_id        String?          @db.Uuid

  @@index([renewed_from_agreement_id])
  @@index([renewed_to_agreement_id])
}

model payment_link_tokens {
  token            String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  obligation_id    String?            @db.Uuid
  tenant_id        String             @db.Uuid
  hostel_id        String             @db.Uuid
  owner_id         String             @db.Uuid
  expires_at       DateTime           @db.Timestamptz(6)
  created_at       DateTime           @default(now()) @db.Timestamptz(6)

  rent_obligations rent_obligations?  @relation(fields: [obligation_id], references: [id])
  tenants          tenants            @relation(fields: [tenant_id], references: [id])
  hostels          hostels            @relation(fields: [hostel_id], references: [id])

  @@index([obligation_id])
  @@index([tenant_id])
  @@index([expires_at])
}

model RenewalOffer {
  id                         String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  agreement_id               String                    @db.Uuid
  tenant_id                  String                    @db.Uuid
  hostel_id                  String                    @db.Uuid
  owner_id                   String                    @db.Uuid
  batch_id                   String?                   @db.Uuid

  // Proposed contract terms
  proposed_rent              Decimal                   @db.Decimal(10, 2)
  proposed_security_deposit  Decimal                   @db.Decimal(10, 2)
  proposed_maintenance       Decimal                   @default(0) @db.Decimal(10, 2)
  proposed_maintenance_type  String?
  proposed_duration_months   Int
  proposed_start_date        DateTime                  @db.Date
  proposed_end_date          DateTime                  @db.Date
  proposed_payment_frequency String?
  effective_from             DateTime                  @db.Date  // When the new agreement actually activates

  // Current terms snapshot
  current_rent               Decimal                   @db.Decimal(10, 2)
  current_security_deposit   Decimal                   @db.Decimal(10, 2)
  current_maintenance        Decimal                   @default(0) @db.Decimal(10, 2)

  // Deposit delta
  deposit_held               Decimal                   @default(0) @db.Decimal(10, 2)
  additional_deposit_required Decimal                  @default(0) @db.Decimal(10, 2)
  deposit_refund_eligible    Decimal                   @default(0) @db.Decimal(10, 2)
  deposit_refund_policy      DepositRefundPolicy       @default(KEEP_AS_CREDIT)

  // Notifications
  notification_target        RenewalNotificationTarget @default(TENANT)

  // Status
  status                     RenewalOfferStatus        @default(DRAFT)
  offer_expires_at           DateTime?                 @db.Timestamptz(6)
  sent_at                    DateTime?                 @db.Timestamptz(6)
  accepted_at                DateTime?                 @db.Timestamptz(6)
  declined_at                DateTime?                 @db.Timestamptz(6)
  decline_reason             String?
  revised_from_offer_id      String?                   @db.Uuid

  // Owner notes
  owner_notes                String?
  is_custom_override         Boolean                   @default(false)

  // Result
  resulting_agreement_id     String?                   @db.Uuid

  created_at                 DateTime                  @default(now()) @db.Timestamptz(6)
  updated_at                 DateTime?                 @db.Timestamptz(6)

  // Relations
  agreement                  Agreement                 @relation("OfferSourceAgreement", fields: [agreement_id], references: [id], onDelete: Cascade)
  tenant                     tenants                   @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  hostel                     hostels                   @relation(fields: [hostel_id], references: [id], onDelete: Cascade)
  batch                      BulkRenewalBatch?         @relation(fields: [batch_id], references: [id], onDelete: SetNull)
  revised_from_offer         RenewalOffer?             @relation("OfferRevision", fields: [revised_from_offer_id], references: [id], onDelete: SetNull)
  revised_offers             RenewalOffer[]            @relation("OfferRevision")
  resulting_agreement        Agreement?                @relation("OfferResultAgreement", fields: [resulting_agreement_id], references: [id], onDelete: SetNull)
  decisions                  RenewalDecision[]
  timeline_events            RenewalTimelineEvent[]

  @@index([agreement_id, status])
  @@index([tenant_id, status])
  @@index([hostel_id, status])
  @@index([batch_id])
  @@index([status, offer_expires_at])
  @@index([owner_id, hostel_id, status])
}

model BulkRenewalBatch {
  id                     String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  owner_id               String                    @db.Uuid
  hostel_id              String                    @db.Uuid
  title                  String                    @default("Bulk Renewal")
  filter_criteria        Json                      @default("{}")
  renewal_strategy       String                    @default("FLAT")  // FLAT | PERCENTAGE | ROOM_CATEGORY
  proposed_rent          Decimal?                  @db.Decimal(10, 2)
  proposed_deposit       Decimal?                  @db.Decimal(10, 2)
  proposed_duration_months Int?
  rent_increase_amount   Decimal?                  @db.Decimal(10, 2)
  rent_increase_percent  Decimal?                  @db.Decimal(5, 2)
  offers_generated       Int                       @default(0)
  offers_sent            Int                       @default(0)
  offers_accepted        Int                       @default(0)
  offers_declined        Int                       @default(0)
  status                 String                    @default("DRAFT")

  // Deposit and Notification snapshotted strategies
  deposit_refund_policy  DepositRefundPolicy       @default(KEEP_AS_CREDIT)
  notification_target    RenewalNotificationTarget @default(TENANT)
  strategy_type          String?                   // snapshot e.g. FLAT, PERCENTAGE, ROOM_CATEGORY
  room_category_snapshot String?                   // snapshot of room category target

  created_at             DateTime                  @default(now()) @db.Timestamptz(6)
  completed_at           DateTime?                 @db.Timestamptz(6)

  hostel                 hostels                   @relation(fields: [hostel_id], references: [id], onDelete: Cascade)
  offers                 RenewalOffer[]

  @@index([owner_id, hostel_id, status])
}

model RenewalDecision {
  id         String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  offer_id   String             @db.Uuid
  tenant_id  String             @db.Uuid
  decision   RenewalOfferStatus
  reason     String?
  created_at DateTime           @default(now()) @db.Timestamptz(6)

  offer      RenewalOffer       @relation(fields: [offer_id], references: [id], onDelete: Cascade)
  tenant     tenants            @relation(fields: [tenant_id], references: [id], onDelete: Cascade)

  @@index([offer_id])
  @@index([tenant_id])
}

// Append-only renewal timeline: the queryable audit trail RenewalDecision
// only partially provides (tenant actions only, no actor-role, no owner-side
// events at all — those previously lived only in logger.info() calls with no
// DB record). Written inside the same transaction as the mutation it
// describes wherever the caller already has one open, per the "audit writes
// must be transactionally coupled" finding (see Decisions.md).
model RenewalTimelineEvent {
  id           String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  hostel_id    String                    @db.Uuid
  tenant_id    String                    @db.Uuid
  agreement_id String?                   @db.Uuid
  offer_id     String?                   @db.Uuid
  event_type   RenewalTimelineEventType
  actor_type   RenewalTimelineActorType
  actor_id     String?                   @db.Uuid
  reason       String?
  metadata     Json?
  created_at   DateTime                  @default(now()) @db.Timestamptz(6)

  hostel       hostels                   @relation(fields: [hostel_id], references: [id], onDelete: Cascade)
  tenant       tenants                   @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  agreement    Agreement?                @relation(fields: [agreement_id], references: [id], onDelete: SetNull)
  offer        RenewalOffer?             @relation(fields: [offer_id], references: [id], onDelete: SetNull)

  @@index([tenant_id, created_at])
  @@index([agreement_id, created_at])
  @@index([offer_id, created_at])
  @@index([hostel_id, created_at])
}

enum RenewalTimelineEventType {
  OFFER_CREATED
  OFFER_SENT
  OFFER_DISCUSSED
  OFFER_REVISED
  OFFER_ACCEPTED
  OFFER_DECLINED
  OFFER_EXPIRED
  DRAFT_CREATED
  RENEWAL_ACTIVATED
  RENEWAL_ACTIVATION_BLOCKED
}

enum RenewalTimelineActorType {
  OWNER
  TENANT
  SYSTEM
}

enum DepositRefundPolicy {
  KEEP_AS_DEPOSIT
  KEEP_AS_CREDIT
  REFUND
}

enum RenewalNotificationTarget {
  TENANT
  GUARDIAN
  BOTH
}

enum HostelStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

model payment_recovery_operations {
  id                   String    @id @db.Uuid
  payment_id           String    @unique
  attempt_id           String    @db.Uuid
  incorrect_attempt_id String?   @db.Uuid
  status               String
  operator             String
  checksum             String
  started_at           DateTime  @default(now()) @db.Timestamptz(6)
  finished_at          DateTime? @db.Timestamptz(6)
  metadata             Json?

  @@map("payment_recovery_operations")
}

// ════════════════════════════════════════════════════════════
// Change Management System
// Centralized lifecycle for all governed data modifications.
// ════════════════════════════════════════════════════════════

enum ChangeRequestStatus {
  PENDING
  APPROVED
  REJECTED
  EXPIRED
  APPLIED
  CANCELLED
  SUPERSEDED
}

enum ChangeCategory {
  A  // Owner Controlled
  B  // Shared Profile (tenant approval)
  C  // Contractual (agreement amendment)
  D  // Financial (reversal only)
}

enum ChangeApprovalLevel {
  L0  // System only
  L1  // Owner only
  L2  // Owner + Tenant
  L3  // Owner + Tenant + Financial Engine
}

model change_requests {
  id                  String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  // Scoping
  owner_id            String              @db.Uuid
  hostel_id           String?             @db.Uuid
  tenant_id           String?             @db.Uuid

  // Target Entity & Concurrency Control
  entity_type         String              // 'tenant', 'profile', 'agreement', 'obligation', 'room_allocation'
  entity_id           String              @db.Uuid
  entity_version      Int                 @default(1)
  correlation_id      String?             @db.Uuid

  // Classification
  change_category     ChangeCategory
  change_type         String              // 'profile_update', 'contract_amendment', 'financial_correction', 'administrative_correction'
  approval_level      ChangeApprovalLevel

  // Lifecycle
  status              ChangeRequestStatus @default(PENDING)

  // Actors
  requested_by        String              @db.Uuid
  requested_at        DateTime            @default(now()) @db.Timestamptz(6)
  approved_by         String?             @db.Uuid
  approved_at         DateTime?           @db.Timestamptz(6)
  rejected_by         String?             @db.Uuid
  rejected_at         DateTime?           @db.Timestamptz(6)
  applied_at          DateTime?           @db.Timestamptz(6)
  cancelled_at        DateTime?           @db.Timestamptz(6)

  // Content (Derived after state is computed as before + diff)
  before              Json                // Complete before-state
  diff                Json                // Only changed fields (diff)
  reason              String              // Mandatory reason for change
  effective_date      DateTime?           @db.Date

  // Expiration
  expires_at          DateTime?           @db.Timestamptz(6)
  reminder_count      Int                 @default(0)
  last_reminded_at    DateTime?           @db.Timestamptz(6)

  // Agreement Versioning (Cat C)
  creates_version     Int?
  supersedes_version  Int?

  // Metadata
  metadata            Json?
  created_at          DateTime            @default(now()) @db.Timestamptz(6)
  updated_at          DateTime?           @db.Timestamptz(6)

  // Relations
  tenant              tenants?            @relation(fields: [tenant_id], references: [id])
  hostel              hostels?            @relation(fields: [hostel_id], references: [id])
  events              change_request_events[]

  @@index([tenant_id, status])
  @@index([owner_id, status])
  @@index([entity_type, entity_id])
  @@index([expires_at], map: "idx_cr_pending_expiry")
  @@index([hostel_id, status])
  @@index([correlation_id])
}

model change_request_events {
  id                  String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  change_request_id   String              @db.Uuid

  action              String              // 'created', 'reminded', 'approved', 'rejected', 'expired', 'applied', 'cancelled'
  actor_id            String?             @db.Uuid
  actor_role          String              // 'owner', 'tenant', 'system'

  snapshot            Json?               // State at time of action
  notes               String?
  ip_address          String?
  user_agent          String?

  created_at          DateTime            @default(now()) @db.Timestamptz(6)

  change_request      change_requests     @relation(fields: [change_request_id], references: [id], onDelete: Cascade)

  @@index([change_request_id])
}

enum RecoveryTier {
  OPERATIONAL_UNDO
  FINANCIAL_CORRECTION
  ADMINISTRATIVE_REVERSAL
}

enum CorrectionDomain {
  PAYMENTS
  ROOMS
  AGREEMENTS
  EXPENSES
  ADMISSIONS
  RENEWALS
  SETTINGS
  DOCUMENTS
  KYC
  RESERVATIONS
}

enum CaseStatus {
  DRAFT
  PREVIEW
  VALIDATED
  EXECUTING
  COMPLETED
  FAILED
  EXPIRED
  CANCELLED
}

model correction_cases {
  id               String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  hostel_id        String                   @db.Uuid
  domain           CorrectionDomain
  case_type        String
  tier             RecoveryTier
  status           CaseStatus               @default(DRAFT)
  entity_refs      Json
  reason           String
  actor_id         String                   @db.Uuid
  actor_role       String
  before_snapshot  Json
  preview_impact   Json?
  execution_result Json?
  case_detail      Json
  idempotency_key  String                   @unique
  depends_on       String[]                 @default([])
  undo_expires_at  DateTime?                @db.Timestamptz(6)
  correlation_id   String?                  @db.Uuid
  created_at       DateTime                 @default(now()) @db.Timestamptz(6)
  updated_at       DateTime?                @db.Timestamptz(6)
  hostels          hostels                  @relation(fields: [hostel_id], references: [id])
  events           correction_case_events[]

  @@index([hostel_id])
  @@index([hostel_id, status])
  @@index([status, undo_expires_at])
  @@index([case_type])
}

model correction_case_events {
  id                 String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  correction_case_id String           @db.Uuid
  event_type         String
  actor_id           String           @db.Uuid
  actor_role         String
  reason             String?
  snapshot           Json?
  ip_address         String?
  user_agent         String?
  created_at         DateTime         @default(now()) @db.Timestamptz(6)
  correction_case    correction_cases @relation(fields: [correction_case_id], references: [id])

  @@index([correction_case_id])
}

// ============================================================
// Food: Monthly Planning & Voting (V1)
// ============================================================

enum FoodMealType {
  BREAKFAST
  LUNCH
  SNACKS
  DINNER
}

enum FoodDayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

enum FoodVotingStatus {
  DRAFT
  OPEN
  CLOSED
}

enum FoodScheduleStatus {
  DRAFT
  PUBLISHED
}

enum FoodScheduleSource {
  GENERATED
  CARRIED_FORWARD
  MANUAL
}

/// Persistent per-hostel food-item library, grouped by meal type. Owner
/// maintains this over time; items are deactivated (never hard-deleted) once
/// referenced by a schedule, so past months' schedules stay intact.
model food_menu_items {
  id                  String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  hostel_id           String                @db.Uuid
  owner_id            String                @db.Uuid
  meal_type           FoodMealType
  name                String
  is_active           Boolean               @default(true)
  created_at          DateTime              @default(now()) @db.Timestamptz(6)
  updated_at          DateTime?             @db.Timestamptz(6)
  hostels             hostels               @relation(fields: [hostel_id], references: [id], onDelete: Cascade)
  food_votes          food_votes[]
  food_schedule_meals food_schedule_meals[]

  @@unique([hostel_id, meal_type, name])
  @@index([hostel_id, meal_type])
}

/// One voting round per hostel per month. Tenants can select multiple items
/// per meal type (toggle each item's vote) while status = OPEN and now() is
/// within [voting_starts_at, voting_ends_at] — the generator builds a
/// balanced weekly schedule from the resulting collective preferences.
model food_voting_periods {
  id               String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  hostel_id        String              @db.Uuid
  owner_id         String              @db.Uuid
  month            DateTime            @db.Date
  voting_starts_at DateTime            @db.Timestamptz(6)
  voting_ends_at   DateTime            @db.Timestamptz(6)
  status           FoodVotingStatus    @default(DRAFT)
  created_at       DateTime            @default(now()) @db.Timestamptz(6)
  updated_at       DateTime?           @db.Timestamptz(6)
  hostels          hostels             @relation(fields: [hostel_id], references: [id], onDelete: Cascade)
  food_votes       food_votes[]
  food_schedules   food_schedules[]

  @@unique([hostel_id, month])
}

/// One row per tenant per meal type per *item* — tenants may select multiple
/// items per meal type, and `POST /api/food/tenant/vote` toggles each one on
/// or off. The unique constraint includes `menu_item_id` precisely so a second
/// pick is a second row rather than an overwrite.
model food_votes {
  id                  String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  voting_period_id    String               @db.Uuid
  tenant_id           String               @db.Uuid
  meal_type           FoodMealType
  menu_item_id        String               @db.Uuid
  created_at          DateTime             @default(now()) @db.Timestamptz(6)
  updated_at          DateTime?            @db.Timestamptz(6)
  food_voting_periods food_voting_periods  @relation(fields: [voting_period_id], references: [id], onDelete: Cascade)
  tenants             tenants              @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  food_menu_items     food_menu_items      @relation(fields: [menu_item_id], references: [id], onDelete: Cascade)

  @@unique([voting_period_id, tenant_id, meal_type, menu_item_id])
  @@index([voting_period_id, meal_type])
}

/// One mutable row per hostel per month — the weekly (Mon-Sun) meal pattern.
/// Editing after publish updates this same row, which is what tenants read;
/// there is no separate "republish" step.
model food_schedules {
  id                               String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  hostel_id                        String               @db.Uuid
  owner_id                         String               @db.Uuid
  month                            DateTime             @db.Date
  status                           FoodScheduleStatus   @default(DRAFT)
  source                           FoodScheduleSource   @default(GENERATED)
  generated_from_voting_period_id  String?              @db.Uuid
  published_at                     DateTime?            @db.Timestamptz(6)
  created_at                       DateTime             @default(now()) @db.Timestamptz(6)
  updated_at                       DateTime?            @db.Timestamptz(6)
  hostels                          hostels              @relation(fields: [hostel_id], references: [id], onDelete: Cascade)
  food_voting_periods               food_voting_periods? @relation(fields: [generated_from_voting_period_id], references: [id], onDelete: SetNull)
  food_schedule_meals               food_schedule_meals[]

  @@unique([hostel_id, month])
}

/// 7 days x 4 meal types = 28 rows per schedule. `item_name` is a denormalized
/// snapshot at assignment time so history survives a later library-item edit/deactivation.
model food_schedule_meals {
  id              String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schedule_id     String           @db.Uuid
  day_of_week     FoodDayOfWeek
  meal_type       FoodMealType
  menu_item_id    String?          @db.Uuid
  item_name       String
  created_at      DateTime         @default(now()) @db.Timestamptz(6)
  updated_at      DateTime?        @db.Timestamptz(6)
  food_schedules  food_schedules   @relation(fields: [schedule_id], references: [id], onDelete: Cascade)
  food_menu_items food_menu_items? @relation(fields: [menu_item_id], references: [id], onDelete: SetNull)

  @@unique([schedule_id, day_of_week, meal_type])
}

// ============================================================
// Food Polls (V1) — deliberately independent of the
// food_voting_periods/food_votes system above, which is dormant
// (decoupled from schedule generation, see ADR-056). An ad-hoc,
// owner-created, single-instance poll — not a monthly recurring window.
// See docs/obsidian/Food.md and ADR-057.
// ============================================================

enum FoodPollType {
  SINGLE_CHOICE
  MULTIPLE_CHOICE
  RATING
  YES_NO
}

enum FoodPollStatus {
  OPEN
  CLOSED
}

/// One ad-hoc poll, created and published in a single owner action (no
/// draft state). `RATING`/`YES_NO` polls still use `food_poll_options` —
/// the frontend resolves their fixed option set ("Yes"/"No", "5 stars"..
/// "1 star") at creation time, same as every other poll type, so one
/// options+votes model covers all four types with no nullable branches.
model food_polls {
  id               String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  hostel_id        String              @db.Uuid
  owner_id         String              @db.Uuid
  title            String
  poll_type        FoodPollType
  meal_type        FoodMealType
  poll_date        DateTime            @db.Date
  closes_at        DateTime            @db.Timestamptz(6)
  is_anonymous     Boolean             @default(true)
  allow_multiple   Boolean             @default(false)
  status           FoodPollStatus      @default(OPEN)
  closed_at        DateTime?           @db.Timestamptz(6)
  created_at       DateTime            @default(now()) @db.Timestamptz(6)
  updated_at       DateTime?           @db.Timestamptz(6)
  hostels          hostels             @relation(fields: [hostel_id], references: [id], onDelete: Cascade)
  food_poll_options food_poll_options[]
  food_poll_votes   food_poll_votes[]

  @@index([hostel_id, status])
}

model food_poll_options {
  id              String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  poll_id         String            @db.Uuid
  label           String
  position        Int
  created_at      DateTime          @default(now()) @db.Timestamptz(6)
  food_polls      food_polls        @relation(fields: [poll_id], references: [id], onDelete: Cascade)
  food_poll_votes food_poll_votes[]

  @@unique([poll_id, position])
}

/// `allow_multiple = false` polls are enforced in application logic (a vote
/// replaces any other row for the same poll+tenant), not by this constraint
/// alone — the constraint's job is only to prevent a duplicate vote on the
/// same option, same as `food_votes`.
model food_poll_votes {
  id                String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  poll_id           String            @db.Uuid
  option_id         String            @db.Uuid
  tenant_id         String            @db.Uuid
  created_at        DateTime          @default(now()) @db.Timestamptz(6)
  food_polls        food_polls        @relation(fields: [poll_id], references: [id], onDelete: Cascade)
  food_poll_options food_poll_options @relation(fields: [option_id], references: [id], onDelete: Cascade)
  tenants           tenants           @relation(fields: [tenant_id], references: [id], onDelete: Cascade)

  @@unique([poll_id, tenant_id, option_id])
  @@index([poll_id])
}

// Tenant App: Home tab content (V1)

/// Owner-authored notices shown on the tenant Home tab. Deliberately minimal
/// (title/body only) — no read-tracking, no scheduling; see docs/obsidian
/// Decisions.md for why this wasn't folded into the generic notifications table.
model hostel_announcements {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  hostel_id  String    @db.Uuid
  owner_id   String    @db.Uuid
  title      String
  body       String
  created_at DateTime  @default(now()) @db.Timestamptz(6)
  updated_at DateTime? @db.Timestamptz(6)
  hostels    hostels   @relation(fields: [hostel_id], references: [id], onDelete: Cascade)

  @@index([hostel_id, created_at(sort: Desc)])
}

/// Owner-authored upcoming events (deep cleaning, festival dinner, etc.)
/// shown on the tenant Home tab.
model hostel_events {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  hostel_id   String    @db.Uuid
  owner_id    String    @db.Uuid
  title       String
  event_date  DateTime  @db.Date
  description String?
  created_at  DateTime  @default(now()) @db.Timestamptz(6)
  updated_at  DateTime? @db.Timestamptz(6)
  hostels     hostels   @relation(fields: [hostel_id], references: [id], onDelete: Cascade)

  @@index([hostel_id, event_date])
}

// Tenant App: Room tab — Service Requests domain (V1)

enum ServiceRequestType {
  MAINTENANCE
  ROOM_CHANGE
  CLEANING
  LOST_KEY
  VISITOR_PASS
  EXTRA_MATTRESS
}

enum ServiceRequestStatus {
  RAISED
  ASSIGNED
  IN_PROGRESS
  RESOLVED
  REJECTED
}

enum UtilityType {
  WATER
  WIFI
  ELECTRICITY
  CLEANING
}

enum UtilityStatus {
  OK
  ISSUE
  OUTAGE
}

/// One request per tenant action from the Room tab's 6 request types
/// (maintenance ticket, room change, cleaning, lost key, visitor pass, extra
/// mattress) — one unified model since the design itself drives all 6 off a
/// single generic form/detail engine, not six separate flows.
model tenant_service_requests {
  id                          String                        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  hostel_id                   String                        @db.Uuid
  tenant_id                   String                        @db.Uuid
  type                        ServiceRequestType
  category                    String?
  description                 String?
  photo_url                   String?
  status                      ServiceRequestStatus           @default(RAISED)
  assigned_to                 String?
  eta                         DateTime?                     @db.Timestamptz(6)
  fee_amount                  Decimal?                      @db.Decimal(10, 2)
  created_at                  DateTime                      @default(now()) @db.Timestamptz(6)
  updated_at                  DateTime?                     @db.Timestamptz(6)
  hostels                     hostels                       @relation(fields: [hostel_id], references: [id], onDelete: Cascade)
  tenants                     tenants                       @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  tenant_service_request_events tenant_service_request_events[]

  @@index([hostel_id, status])
  @@index([tenant_id, created_at(sort: Desc)])
}

/// Append-only timeline for a service request (status changes + comments),
/// same spirit as `RenewalTimelineEvent` (ADR-016) — one row per state change.
model tenant_service_request_events {
  id                      String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  request_id              String                  @db.Uuid
  status                  ServiceRequestStatus
  note                    String?
  actor_role              String
  created_at              DateTime                @default(now()) @db.Timestamptz(6)
  tenant_service_requests tenant_service_requests @relation(fields: [request_id], references: [id], onDelete: Cascade)

  @@index([request_id, created_at])
}

/// Owner-editable utility/facility status shown on the tenant Room tab
/// (water/wifi/electricity/cleaning) — one row per hostel per utility type.
model hostel_utility_status {
  id         String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  hostel_id  String        @db.Uuid
  utility    UtilityType
  status     UtilityStatus @default(OK)
  note       String?
  updated_at DateTime      @default(now()) @db.Timestamptz(6)
  hostels    hostels       @relation(fields: [hostel_id], references: [id], onDelete: Cascade)

  @@unique([hostel_id, utility])
}

// Platform Admin Console (V1) — multi-tenant SaaS platform-admin model.
// Deliberately reverses ADR-006 (which removed the multi-hostel SaaS
// billing/subscription model) per explicit user product direction — see
// docs/obsidian/Decisions.md ADR-030.

enum PlatformAdminTitle {
  OWNER
  SALES
  VERIFICATION
}

/// A platform staff account — profile.role = ADMIN, with a sub-title for the
/// Admin Users panel. No public self-serve signup; the first admin is
/// created by a one-time seed script, later admins via the Admin Users panel.
model platform_admins {
  id         String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  profile_id String             @unique @db.Uuid
  title      PlatformAdminTitle @default(SALES)
  created_at DateTime           @default(now()) @db.Timestamptz(6)
  profile    profile            @relation(fields: [profile_id], references: [id], onDelete: Cascade)
}

enum HostelVerificationStatus {
  PENDING
  VERIFIED
}

enum HostelListingStatus {
  DRAFT
  LIVE
  SUSPENDED
}

/// Real business-progress lifecycle (owner-acquisition-funnel phase 2).
/// NEW/UNDER_REVIEW/LOST are the only admin-settable values (see
/// PATCH /api/platform-admin/leads/[id]); APPROVED onward is system-managed —
/// set only by lead-invitation-service.ts and the auto-progression choke
/// points in owner-signup and owner/hostels. See Decisions.md ADR for the
/// migration mapping from the old 6-value enum.
enum PlatformLeadStatus {
  NEW
  UNDER_REVIEW
  APPROVED
  INVITE_SENT
  OWNER_ACTIVATED
  HOSTEL_CREATED
  LIVE
  LOST
}

/// Single-use activation token for a platform_leads row, generated when an
/// admin approves a lead. Mirrors tenant_invitations' shape (separate opaque
/// `token` column, never the row `id`) — not shared code, since this is a
/// different entity with no tenant/hostel context yet.
model platform_lead_invitations {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  lead_id    String    @db.Uuid
  token      String    @unique
  status     String    @default("PENDING") // PENDING -> OPENED -> ACTIVATED, or EXPIRED/CANCELLED
  expires_at DateTime  @db.Timestamptz(6)
  created_at DateTime  @default(now()) @db.Timestamptz(6)
  updated_at DateTime? @db.Timestamptz(6)

  @@index([lead_id])
}

/// Prospective hostel OWNERS signing up to the platform — distinct from the
/// pre-existing `leads` table, which is prospective TENANTS applying to a
/// specific hostel via the admissions/CRM feature. Different concept,
/// different route namespace (`/api/platform-admin/leads`).
model platform_leads {
  id                 String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name               String
  hostel_name        String
  phone              String
  google_email       String?
  phone_verified     Boolean             @default(false)
  city               String?
  bed_count          Int?
  status             PlatformLeadStatus  @default(NEW)
  notes              String?
  /// Bearer secret for the public /enquiry/:token status page. Not the row
  /// id — the id is used in admin URLs and must not become guessable-adjacent
  /// to a public surface. Never expires (unlike platform_lead_invitations.token,
  /// which is a 7-day single-use activation credential).
  tracking_token     String              @unique
  /// Admin-authored, deliberately owner-visible. Distinct from `notes`, which
  /// is an internal scratchpad and is never returned by a public route.
  applicant_message  String?
  /// Set only by POST /api/platform-admin/leads/[id]/reject.
  rejection_reason   String?
  /// Qualification answers from the conversational capture flow. Deliberately
  /// free-form strings rather than enums — the option lists are marketing copy
  /// and will be reworded without wanting a migration each time. The tradeoff
  /// is that a reworded option produces a new distinct value, so these are not
  /// safe to aggregate without normalising first.
  pain_point         String?
  current_tooling    String?
  converted_owner_id String?             @db.Uuid
  created_at         DateTime            @default(now()) @db.Timestamptz(6)
  updated_at         DateTime?           @db.Timestamptz(6)

  @@index([status, created_at(sort: Desc)])
}

enum SubscriptionBillingCycle {
  MONTHLY
  YEARLY
}

/// The marketplace plan catalog owners subscribe to — reintroduces a plan
/// concept, deliberately reshaped around "marketplace tier" rather than the
/// old metered-usage `plans` table ADR-006 dropped.
model subscription_plans {
  id                   String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                 String
  price_amount         Decimal                  @db.Decimal(10, 2)
  billing_cycle        SubscriptionBillingCycle
  description          String?
  is_active            Boolean                  @default(true)
  created_at           DateTime                 @default(now()) @db.Timestamptz(6)
  updated_at           DateTime?                @db.Timestamptz(6)
  hostel_subscriptions hostel_subscriptions[]
}

enum HostelSubscriptionStatus {
  TRIAL
  ACTIVE
  RENEWAL_DUE
  PAYMENT_FAILED
  CANCELLED
}

/// One row per hostel — its subscription to Stayo. `hostel_id` is unique:
/// a hostel has exactly one subscription record at a time (change plan =
/// update this row, not a new row).
model hostel_subscriptions {
  id                 String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  hostel_id          String                    @unique @db.Uuid
  plan_id            String                    @db.Uuid
  status             HostelSubscriptionStatus  @default(TRIAL)
  billing_cycle      SubscriptionBillingCycle
  amount             Decimal                   @db.Decimal(10, 2)
  autopay_enabled    Boolean                   @default(false)
  trial_ends_at      DateTime?                 @db.Timestamptz(6)
  next_renewal_at    DateTime?                 @db.Timestamptz(6)
  created_at         DateTime                  @default(now()) @db.Timestamptz(6)
  updated_at         DateTime?                 @db.Timestamptz(6)
  hostels            hostels                   @relation(fields: [hostel_id], references: [id], onDelete: Cascade)
  subscription_plans subscription_plans        @relation(fields: [plan_id], references: [id])
  platform_invoices  platform_invoices[]

  @@index([status])
}

enum PlatformInvoiceStatus {
  PENDING
  PAID
  FAILED
}

/// Record of an owner paying Stayo a subscription fee — backs collected/
/// outstanding/GST figures and the Revenue tab's CSV exports.
model platform_invoices {
  id                      String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  hostel_subscription_id  String                @db.Uuid
  hostel_id               String                @db.Uuid
  amount                  Decimal               @db.Decimal(10, 2)
  status                  PlatformInvoiceStatus @default(PENDING)
  invoice_number          String                @unique
  paid_at                 DateTime?             @db.Timestamptz(6)
  created_at              DateTime              @default(now()) @db.Timestamptz(6)
  hostel_subscriptions    hostel_subscriptions  @relation(fields: [hostel_subscription_id], references: [id], onDelete: Cascade)
  hostels                 hostels               @relation(fields: [hostel_id], references: [id], onDelete: Cascade)

  @@index([hostel_id, created_at(sort: Desc)])
  @@index([status])
}

enum NotificationTemplateChannel {
  WHATSAPP
  EMAIL
}

/// Admin-configured owner-facing message templates (Welcome, Verification
/// Approved, Changes Requested) — content only; sending reuses the existing
/// notification infra, this table doesn't duplicate delivery logic.
model notification_templates {
  id         String                       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name       String
  channel    NotificationTemplateChannel
  body       String
  is_active  Boolean                      @default(true)
  created_at DateTime                     @default(now()) @db.Timestamptz(6)
  updated_at DateTime?                    @db.Timestamptz(6)
}

/// Generic key-value store for platform-wide admin settings (e.g. "general"
/// → {supportEmail, supportPhone, businessAddress}) — a small singleton-per-
/// key table rather than one column per setting, since More/Settings has no
/// other config store to plug into.
model platform_settings {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  key        String    @unique
  value      Json
  updated_at DateTime? @db.Timestamptz(6)
}

/// Owner KYC documents (ADR-038). Deliberately separate from
/// `identificationDocument`, which is FK'd to `tenants` and cannot represent an
/// owner. Files live in ImageKit; only metadata is stored here.
model owner_documents {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  profile_id      String    @db.Uuid
  doc_type        String    // AADHAAR | PAN | PHOTO
  file_url        String
  file_id         String?   // ImageKit id, needed to delete the asset
  mime_type       String
  file_size       Int
  /// PENDING until a Stayo admin reviews it — never set by the uploader.
  status          String    @default("PENDING")
  is_active       Boolean   @default(true)
  uploaded_at     DateTime  @default(now()) @db.Timestamptz(6)
  reviewed_at     DateTime? @db.Timestamptz(6)
  reviewed_by     String?   @db.Uuid
  /// Why an admin rejected it, shown to the owner so they know what to fix.
  /// A rejection with no reason just makes them upload the same file again.
  review_note     String?

  profile         profile   @relation(fields: [profile_id], references: [id], onDelete: Cascade)

  @@unique([profile_id, doc_type, is_active])
  @@index([profile_id])
  @@index([status])
}
