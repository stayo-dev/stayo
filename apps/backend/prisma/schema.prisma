generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["relationJoins"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model actionLog {
  id         String   @id @db.Uuid
  owner_id   String   @db.Uuid
  action     String
  created_at DateTime @default(now()) @db.Timestamptz(6)

  @@index([owner_id, action, created_at(sort: Desc)])
  @@map("action_logs")
}

model activity_logs {
  id          String   @id @db.Uuid
  user_id     String   @db.Uuid
  owner_id    String?  @db.Uuid
  action_type String
  entity_type String
  entity_id   String?
  metadata    Json?
  timestamp   DateTime @default(now()) @db.Timestamptz(6)
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model bulk_import_batches {
  id                                                     String    @id @db.Uuid
  owner_id                                               String    @db.Uuid
  hostel_id                                              String    @db.Uuid
  filename                                               String
  file_size                                              Int?
  total_rows                                             Int       @default(0)
  valid_rows                                             Int       @default(0)
  failed_rows                                            Int       @default(0)
  imported_rows                                          Int       @default(0)
  duplicate_rows                                         Int       @default(0)
  status                                                 String    @default("PENDING")
  validation_errors                                      Json?
  import_summary                                         Json?
  import_source_version                                  String    @default("google_form_v1")
  uploaded_by                                            String    @db.Uuid
  uploaded_at                                            DateTime  @default(now()) @db.Timestamptz(6)
  validated_at                                           DateTime? @db.Timestamptz(6)
  imported_at                                            DateTime? @db.Timestamptz(6)
  created_at                                             DateTime  @default(now()) @db.Timestamptz(6)
  updated_at                                             DateTime? @db.Timestamptz(6)
  hostels                                                hostels   @relation(fields: [hostel_id], references: [id])
  profiles_bulk_import_batches_uploaded_byToprofiles     profile   @relation("bulk_import_batches_uploaded_byToprofiles", fields: [uploaded_by], references: [id])
  profiles_profiles_import_batch_idTobulk_import_batches profile[] @relation("profiles_import_batch_idTobulk_import_batches")
  bulk_import_rows                                      bulk_import_rows[]
  tenant_invitations                                    tenant_invitations[]
  tenant_invitation_reservations                        tenant_invitation_reservations[]

  @@index([hostel_id, created_at(sort: Desc)])
  @@index([owner_id, created_at(sort: Desc)])
  @@index([status, created_at(sort: Desc)])
}

model bulk_import_rows {
  id                  String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  batch_id            String    @db.Uuid
  owner_id            String    @db.Uuid
  hostel_id           String    @db.Uuid
  row_number          Int
  normalized_email    String
  normalized_phone    String
  normalized_room     String
  mapped_data         Json
  validation_status   String    @default("PENDING")
  conflict_type       String?
  owner_decision      String?
  tenant_id           String?   @db.Uuid
  invitation_id       String?   @db.Uuid
  reservation_id      String?   @db.Uuid
  execution_status    String    @default("PENDING")
  email_status        String?
  error_message       String?
  executed_at         DateTime? @db.Timestamptz(6)
  created_at          DateTime  @default(now()) @db.Timestamptz(6)
  updated_at          DateTime? @db.Timestamptz(6)
  batch               bulk_import_batches @relation(fields: [batch_id], references: [id])
  tenant              tenants? @relation(fields: [tenant_id], references: [id])
  invitation          tenant_invitations? @relation(fields: [invitation_id], references: [id])
  reservation         tenant_invitation_reservations? @relation(fields: [reservation_id], references: [id])

  @@unique([batch_id, normalized_email, normalized_phone])
  @@index([owner_id, hostel_id, execution_status])
  @@index([batch_id, validation_status])
  @@index([tenant_id])
  @@map("bulk_import_rows")
}

model complaints {
  id          String    @id @db.Uuid
  tenant_id   String    @db.Uuid
  owner_id    String    @db.Uuid
  title       String
  description String
  category    String
  status      String    @default("PENDING")
  priority    String    @default("MEDIUM")
  resolved_at DateTime? @db.Timestamptz(6)
  comment     String?
  created_at  DateTime  @default(now()) @db.Timestamptz(6)
  updated_at  DateTime? @db.Timestamptz(6)
  hostel_id   String    @db.Uuid
  hostels     hostels   @relation(fields: [hostel_id], references: [id])
  tenants     tenants   @relation(fields: [tenant_id], references: [id])

  @@index([hostel_id])
}

model expenses {
  id                  String    @id @db.Uuid
  owner_id            String    @db.Uuid
  title               String
  amount              Decimal   @db.Decimal(10, 2)
  date                DateTime  @db.Date
  category            String
  status              String?   @default("paid")
  created_at          DateTime  @default(now()) @db.Timestamptz(6)
  hostel_id           String?   @db.Uuid
  notes               String?
  vendor_name         String?
  payment_method      String?
  receipt_url         String?
  receipt_uploaded_at DateTime? @db.Timestamptz(6)
  is_recurring        Boolean   @default(false)
  recurring_frequency String?
  created_by          String?   @db.Uuid
  approved_by         String?   @db.Uuid
  expense_type        String    @default("VARIABLE")
  expense_scope       ExpenseScope @default(HOSTEL)
  operational_type    String?
  tags                String[]  @default([])
  metadata            Json?
  hostels             hostels?  @relation(fields: [hostel_id], references: [id])
  profiles            profile   @relation(fields: [owner_id], references: [id])

  @@index([date])
  @@index([hostel_id, category, date])
  @@index([hostel_id, date])
  @@index([hostel_id, status])
  @@index([hostel_id])
  @@index([owner_id, date])
  @@index([owner_id])
  @@index([owner_id, title])
  @@index([owner_id, title, date(sort: Desc)])
}

model financial_invariant_failures {
  id                      String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  invariant_type          String
  severity                String
  entity_type             String
  entity_id               String?   @db.Uuid
  expected_value          String?
  actual_value            String?
  owner_id                String?   @db.Uuid
  hostel_id               String?   @db.Uuid
  reconciliation_attempts Int       @default(0)
  status                  String    @default("OPEN")
  details                 Json?
  detected_at             DateTime  @default(now()) @db.Timestamptz(6)
  resolved_at             DateTime? @db.Timestamptz(6)

  @@index([detected_at])
  @@index([hostel_id])
  @@index([invariant_type])
  @@index([severity])
  @@index([status])
}

model hostel_daily_snapshots {
  id                String   @id @db.Uuid
  hostel_id         String   @db.Uuid
  snapshot_date     DateTime @db.Date
  occupancy_rate    Decimal  @default(0) @db.Decimal(7, 2)
  active_tenants    Int      @default(0)
  expected_revenue  Decimal  @default(0) @db.Decimal(12, 2)
  collected_revenue Decimal  @default(0) @db.Decimal(12, 2)
  pending_dues      Decimal  @default(0) @db.Decimal(12, 2)
  overdue_count     Int      @default(0)
  collection_rate   Decimal  @default(0) @db.Decimal(7, 2)
  expenses          Decimal  @default(0) @db.Decimal(12, 2)
  profit            Decimal  @default(0) @db.Decimal(12, 2)
  source_hash       String?
  created_at        DateTime @default(now()) @db.Timestamptz(6)

  @@unique([hostel_id, snapshot_date])
  @@index([snapshot_date])
}

model hostel_invariant_checks {
  id             String   @id @db.Uuid
  check_type     String
  entity_type    String
  entity_id      String?  @db.Uuid
  expected_value String?
  actual_value   String?
  is_valid       Boolean  @default(true)
  details        Json?
  checked_at     DateTime @default(now()) @db.Timestamptz(6)

  @@index([check_type])
  @@index([checked_at])
  @@index([is_valid])
}

model hostels {
  id                  String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  owner_id            String                   @db.Uuid
  name                String
  phone               String
  address             String
  city                String?
  state               String?
  pincode             String?
  upi_id              String?
  gst_number          String?
  is_active           Boolean                  @default(true)
  status              HostelStatus             @default(ACTIVE)
  currency            String                   @default("INR") @db.VarChar(3)
  rent_cycle          String                   @default("MONTHLY")
  receipt_prefix      String                   @default("SAH")
  timezone            String                   @default("UTC")
  auto_rent_day       Int                      @default(1)
  phonepe_merchant_id String?
  public_slug         String?                  @unique
  admissions_enabled  Boolean                  @default(true)
  house_rules         Json?
  /// BOYS | GIRLS | CO_LIVING | WORKING_PROS. Plain string rather than a Prisma
  /// enum, matching this schema's existing convention for descriptive statuses;
  /// the allowed set is enforced by HostelProvisionSchema at the API boundary.
  hostel_type         String?
  food_included       Boolean                  @default(false)
  /// The owner's intent to list publicly, captured at onboarding's Publish step.
  /// Deliberately NOT `listing_status` — that is admin-controlled and paired with
  /// `verification_status` by the Platform Admin console, so an owner writing it
  /// directly would self-approve past platform verification. See ADR-040.
  publish_requested   Boolean                  @default(false)
  /// Owner-controlled position in the Home "Property" list, written only by
  /// PATCH /api/owner/hostels/reorder. Nullable on purpose: NULL means "never
  /// reordered" and sorts last (then by name), so existing hostels keep their
  /// previous name-ascending order with no backfill. See ADR-042.
  display_order       Int?
  verification_status HostelVerificationStatus @default(PENDING)
  listing_status      HostelListingStatus      @default(DRAFT)
  admission_photos    Json?
  created_at          DateTime                 @default(now()) @db.Timestamptz(6)
  updated_at          DateTime?                @db.Timestamptz(6)
  archived_at         DateTime?                @db.Timestamptz(6)
  archived_by         String?                  @db.Uuid
  archive_reason      String?
  logo_url            String?
  preferences_config  Json?
  bulk_import_batches bulk_import_batches[]
  complaints          complaints[]
  rule_acceptances    TenantPolicyAcceptance[]
  expenses            expenses[]
  rule_versions       RuleVersion[]
  profiles            profile                  @relation(fields: [owner_id], references: [id])
  payments            payments[]
  payment_groups      payment_groups[]
  receipts            receipts[]
  reminder_logs       reminder_logs[]
  rent_obligations    rent_obligations[]
  room_allocations    roomAllocation[]
  rooms               rooms[]
  floors              floors[]
  tenants             tenants[]
  move_out_requests   move_out_requests[]
  visitor_leads       visitor_leads[]
  room_reservations   room_reservations[]
  tenant_invitations  tenant_invitations[]
  tenant_invitation_reservations tenant_invitation_reservations[]
  agreements          Agreement[]
  agreement_templates AgreementTemplate[]
  payment_link_tokens payment_link_tokens[]
  renewal_offers      RenewalOffer[]
  bulk_renewal_batches BulkRenewalBatch[]
  change_requests      change_requests[]
  correction_cases     correction_cases[]
  renewal_timeline_events RenewalTimelineEvent[]
  food_menu_items      food_menu_items[]
  food_voting_periods  food_voting_periods[]
  food_schedules       food_schedules[]
  food_polls           food_polls[]
  hostel_announcements hostel_announcements[]
  hostel_events        hostel_events[]
  tenant_service_requests tenant_service_requests[]
  hostel_utility_status   hostel_utility_status[]
  hostel_subscriptions    hostel_subscriptions?
  platform_invoices       platform_invoices[]
}

model identity_tokens {
  jti        String    @id
  user_id    String    @db.Uuid
  purpose    String
  action     String
  expires_at DateTime  @db.Timestamptz(6)
  used       Boolean   @default(false)
  used_at    DateTime? @db.Timestamptz(6)
  created_at DateTime  @default(now()) @db.Timestamptz(6)

  @@index([user_id, used, expires_at])
}

model identificationDocument {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id        String    @db.Uuid
  doc_type         String
  doc_number       String?
  file_url         String
  file_path        String?
  file_id          String?
  mime_type        String
  file_size        Int
  document_status  String    @default("PENDING")
  is_verified      Boolean   @default(false)
  is_active        Boolean   @default(true)
  uploaded_by      String?
  created_at       DateTime  @default(now()) @db.Timestamptz(6)
  updated_at       DateTime? @db.Timestamptz(6)
  rejection_reason String?
  approved_by      String?   @db.Uuid
  approved_at      DateTime? @db.Timestamptz(6)
  rejected_by      String?   @db.Uuid
  rejected_at      DateTime? @db.Timestamptz(6)
  reject_ip        String?
  tenant           tenants   @relation(fields: [tenant_id], references: [id])

  @@index([tenant_id])
  @@index([tenant_id, is_active])
  @@index([tenant_id, doc_type, is_active])
  @@map("identification_documents")
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model login_attempts {
  id             String   @id @db.Uuid
  identifier     String
  ip_address     String?
  attempt_type   String
  success        Boolean  @default(false)
  failure_reason String?
  user_agent     String?
  created_at     DateTime @default(now()) @db.Timestamptz(6)

  @@index([attempt_type, created_at(sort: Desc)])
  @@index([identifier, created_at(sort: Desc)])
  @@index([identifier, ip_address, created_at(sort: Desc)])
  @@index([ip_address, created_at(sort: Desc)])
}

model message_logs {
  id                String   @id @db.Uuid
  owner_id          String?  @db.Uuid
  sent_at           DateTime @default(now()) @db.Timestamptz(6)
  channel           String?
  template          String?
  recipient         String?
  success           Boolean?
  status            String   @default("SUCCESS")
  idempotency_key   String?  @unique
  pack_id           String?  @db.Uuid
  deduction         Int      @default(0)
  provider_response String?
}

model message_packs {
  id                 String   @id @db.Uuid
  owner_id           String   @db.Uuid
  purchased_at       DateTime @default(now()) @db.Timestamptz(6)
  messages_total     Int
  messages_remaining Int
  price_inr          Int
  notes              String?
}

model migration_audit_runs {
  id                          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  audit_date                  DateTime @default(now()) @db.Timestamptz(6)
  artifact_path               String
  orphan_count                Int      @default(0)
  mismatch_count              Int      @default(0)
  unresolved_records_count    Int      @default(0)
  corrected_records_count     Int      @default(0)
  corruption_candidates_count Int      @default(0)
  hostel_rollup_validation    Json?
  summary                     Json?
  artifact                    Json?
  created_at                  DateTime @default(now()) @db.Timestamptz(6)

  @@index([audit_date])
}

model notifications {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  profile_id String   @db.Uuid
  title      String
  message    String
  type       String
  is_read    Boolean  @default(false)
  created_at DateTime @default(now()) @db.Timestamptz(6)
  profiles   profile  @relation(fields: [profile_id], references: [id])
}

model owner_dashboard_snapshots {
  owner_id             String    @id @db.Uuid
  snapshot_month       DateTime  @db.Date
  tenant_count         Int       @default(0)
  active_tenant_count  Int       @default(0)
  total_room_count     Int       @default(0)
  total_capacity       Int       @default(0)
  vacant_beds          Int       @default(0)
  occupancy_rate       Int       @default(0)
  rent_collected_month Decimal   @default(0) @db.Decimal(12, 2)
  expenses_month       Decimal   @default(0) @db.Decimal(12, 2)
  pending_dues         Decimal   @default(0) @db.Decimal(12, 2)
  overdue_total        Decimal   @default(0) @db.Decimal(12, 2)
  overdue_count        Int       @default(0)
  collection_rate      Int       @default(0)
  monthly_trend        Json?
  monthly_trend_months Int       @default(6)
  stats_computed_at    DateTime? @db.Timestamptz(6)
  monthly_computed_at  DateTime? @db.Timestamptz(6)
  is_stale             Boolean   @default(true)
  created_at           DateTime  @default(now()) @db.Timestamptz(6)
  updated_at           DateTime  @db.Timestamptz(6)

  @@index([is_stale])
  @@index([monthly_computed_at])
  @@index([stats_computed_at])
}

model owner_whatsapp_identities {
  id                   String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  owner_id             String    @db.Uuid
  phone_number         String?
  link_code            String?
  link_code_expires_at DateTime? @db.Timestamptz(6)
  is_verified          Boolean   @default(false)
  verified_at          DateTime? @db.Timestamptz(6)
  created_at           DateTime  @default(now()) @db.Timestamptz(6)
  updated_at           DateTime? @db.Timestamptz(6)

  @@unique([link_code])
  @@index([owner_id])
  @@index([phone_number])
  @@index([is_verified, phone_number])
}

model owner_assistant_messages {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  owner_id     String?  @db.Uuid
  phone_number String
  message      String
  command      String?
  success      Boolean  @default(false)
  created_at   DateTime @default(now()) @db.Timestamptz(6)

  @@index([owner_id, created_at])
  @@index([phone_number, created_at])
  @@index([command, created_at])
}

model owner_assistant_confirmations {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  owner_id     String    @db.Uuid
  phone_number String
  action_type  String
  payload_json Json
  status       String    @default("PENDING")
  expires_at   DateTime  @db.Timestamptz(6)
  created_at   DateTime  @default(now()) @db.Timestamptz(6)
  updated_at   DateTime? @db.Timestamptz(6)

  @@index([owner_id, phone_number, action_type, status, expires_at])
  @@index([status, expires_at])
}

model whatsapp_owner_sessions {
  id                        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  owner_id                  String    @db.Uuid
  phone_number              String
  current_screen            String?
  pending_action            Json?
  pending_action_expires_at DateTime? @db.Timestamptz(6)
  last_interaction_at       DateTime  @default(now()) @db.Timestamptz(6)
  created_at                DateTime  @default(now()) @db.Timestamptz(6)
  updated_at                DateTime? @db.Timestamptz(6)

  @@unique([owner_id, phone_number])
  @@index([last_interaction_at])
}

model owner_daily_briefings {
  id                  String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  owner_id            String    @db.Uuid
  local_date          String    // Format: YYYY-MM-DD
  timezone            String    // e.g. "Asia/Kolkata"
  template_name       String    // e.g. "owner_daily_briefing_v1"
  template_version    Int       // e.g. 1
  generated_at        DateTime  @default(now()) @db.Timestamptz(6)
  priority_type       String    // DUES | ONBOARDING | VACANCY | EXPENSE_RATIO | ALERTS | NONE
  priority_payload    Json      // Historical context snapshot
  template_variables  Json      // Variables sent in the template
  sent_at             DateTime? @db.Timestamptz(6)
  delivery_status     String?   // PENDING | DELIVERED | FAILED
  opened_at           DateTime? @db.Timestamptz(6) // Optional for future funnel metrics
  quick_action_clicks Int       @default(0)
  view_dues_clicks    Int       @default(0)
  created_at          DateTime  @default(now()) @db.Timestamptz(6)
  updated_at          DateTime? @db.Timestamptz(6)

  @@unique([owner_id, local_date])
  @@index([owner_id, created_at])
}

model payment_attempt_obligations {
  id                 String           @id @db.Uuid
  payment_attempt_id String           @db.Uuid
  obligation_id      String           @db.Uuid
  amount             Decimal          @db.Decimal(10, 2)
  created_at         DateTime         @default(now()) @db.Timestamptz(6)
  rent_obligations   rent_obligations @relation(fields: [obligation_id], references: [id])
  payment_attempts   paymentAttempt   @relation(fields: [payment_attempt_id], references: [id], onDelete: Cascade)

  @@unique([payment_attempt_id, obligation_id])
}

model payment_attempt_status_events {
  id                   String   @id @db.Uuid
  payment_attempt_id   String   @db.Uuid
  transition_sequence  Int
  from_status          String?
  to_status            String
  reason               String?
  source               String
  actor_id             String?  @db.Uuid
  operational_owner_id String?  @db.Uuid
  financial_owner_id   String?  @db.Uuid
  hostel_id            String?  @db.Uuid
  metadata             Json?
  created_at           DateTime @default(now()) @db.Timestamptz(6)

  @@unique([payment_attempt_id, transition_sequence])
  @@index([hostel_id, created_at])
  @@index([payment_attempt_id, created_at])
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model paymentAttempt {
  id                      String                        @id @db.Uuid
  obligation_id           String?                       @db.Uuid
  tenant_id               String?                       @db.Uuid
  owner_id                String                        @db.Uuid
  provider                String
  merchant_txn_id         String                        @unique
  gateway_txn_id          String?                       @unique
  amount                  Decimal                       @db.Decimal(10, 2)
  status                  AttemptStatus                 @default(CREATED)
  upi_intent_url          String?
  qr_payload              String?
  expires_at              DateTime?                     @db.Timestamptz(6)
  confirmed_at            DateTime?                     @db.Timestamptz(6)
  raw_create_response     Json?
  raw_webhook_payload     Json?
  created_at              DateTime                      @default(now()) @db.Timestamptz(6)
  updated_at              DateTime?                     @db.Timestamptz(6)
  checkout_url            String?
  payment_type            String                        @default("RENT")
  addon_pack              String?
  manual_confirmed_by     String?                       @db.Uuid
  manual_confirmed_at     DateTime?                     @db.Timestamptz(6)
  manual_confirm_ip       String?
  hostel_id               String?                       @db.Uuid
  payment_domain          String?
  scope_type              String?
  flow_type               String?
  merchant_context_type   String?
  merchant_context_id     String?
  settlement_status       String?
  settled_at              DateTime?                     @db.Timestamptz(6)
  merchant_transaction_id String?
  provider_transaction_id String?
  provider_order_id       String?
  provider_reference_id   String?
  settlement_breakdown    Json?
  obligations             payment_attempt_obligations[]
  rent_obligations        rent_obligations?             @relation(fields: [obligation_id], references: [id])
  tenants                 tenants?                      @relation(fields: [tenant_id], references: [id])
  payments                payments[]

  @@index([flow_type])
  @@index([hostel_id])
  @@index([merchant_context_type, merchant_context_id])
