{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": false,
    "allowJs": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": true,
    "baseUrl": ".",
    "ignoreDeprecations": "5.0",
    "paths": {
      "@/*": ["./src/*"],
      "@lib/*": ["./src/lib/*"],
      "@features/*": ["./src/features/*"],
      "@domains/*": ["./src/domains/*"],
      "@platforms/*": ["./src/platforms/*"],
      "@shared/*": ["./src/shared/*"],
      "@infrastructure/*": ["./src/infrastructure/*"],
      "@context/*": ["./src/context/*"],
      "@services/*": ["./src/services/*"]
    }
  },
  "//": "vite.config.ts belongs to tsconfig.node.json (composite). Listing it here too made tsc raise TS6305 for an unbuilt reference output and bail BEFORE checking src/ — so `tsc --noEmit` silently checked nothing, and an undefined component reached production. Keep this include limited to src.",
  "include": ["src"],
  "references": [{ "path": "./tsconfig.node.json" }]
}
