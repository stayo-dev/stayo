# StayO frontend — environment variable reference
#
# Copy to apps/frontend/.env for local dev. On Vercel, set these in the
# frontend project's Environment Variables dashboard instead — separately
# for stayo-production-frontend and stayo-staging-frontend.
#
# All VITE_-prefixed vars are inlined into the client bundle at build time
# (Vite convention) — none of the three below are secrets by design:
# VITE_SUPABASE_ANON_KEY is meant to be public (Supabase enforces access
# control server-side via RLS/the backend, not by hiding this key).

# ============================================================
# Backend API base URL [Per-environment] [Required]
# ============================================================
# No fallback exists — src/lib/api-client.ts throws at import time if this
# is unset. Point Staging's frontend at the Staging backend's real deployed
# URL; never leave this defaulting to Production.
VITE_API_URL=

# ============================================================
# Supabase [Per-environment] [Required]
# ============================================================
# Must point at the SAME Supabase project as this environment's backend
# (SUPABASE_URL in the root .env.example) — a mismatch means the frontend
# and backend disagree about who's logged in.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ============================================================
# Local dev only — never used in a Vercel build [Optional]
# ============================================================
# Deliberately unprefixed so Vite never inlines it into the client bundle.
# Only read by vite.config.ts's dev-server proxy (`vite dev`); production
# builds never read this value.
HMS_API_PROXY_TARGET=http://localhost:3000

# Public half of the VAPID pair, for web push. Not a secret.
VITE_VAPID_PUBLIC_KEY=

# ============================================================
# Clerk [Per-environment] [Optional in Phase 2]
# ============================================================
# ADR-176 Phase 2. Unlike the Supabase vars above, an unset key does NOT throw:
# Clerk is additive while Supabase remains the live session authority, so
# leaving this blank simply makes /sign-in and /sign-up say Clerk is
# unavailable. Nothing else changes.
#
# It must be the VITE_-prefixed name. Clerk's own Next.js docs tell you to set
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY (and that is what the repo-root .env has for
# the backend) — but this app is Vite, which only inlines VITE_* into the
# browser bundle. Setting only the NEXT_PUBLIC_ name is silent; src/lib/auth/
# clerkConfig.ts detects that case specifically and says so.
#
# The publishable key (pk_test_… / pk_live_…) is public by design. The secret
# key (sk_…) must NEVER go here — it would be inlined into the client bundle
# and served to every visitor. clerkConfig.ts rejects an sk_ value outright.
VITE_CLERK_PUBLISHABLE_KEY=
