{
  "buildCommand": "vite build",
  "outputDirectory": "dist",
  "installCommand": "npm install",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://api.yourstayo.com/api/:path*"
    },
    {
      "source": "/api/:path*/",
      "destination": "https://api.yourstayo.com/api/:path*"
    },
    {
      "source": "/pay/tenant/%7B%7B1%7D%7D:token",
      "destination": "https://api.yourstayo.com/api/payments/pay/:token"
    },
    {
      "source": "/pay/tenant/\\{\\{1\\}\\}:token",
      "destination": "https://api.yourstayo.com/api/payments/pay/:token"
    },
    {
      "source": "/pay/tenant/:token",
      "destination": "https://api.yourstayo.com/api/payments/pay/:token"
    },
    {
      "source": "/pay/%7B%7B1%7D%7D:token",
      "destination": "https://api.yourstayo.com/api/payments/pay/:token"
    },
    {
      "source": "/pay/\\{\\{1\\}\\}:token",
      "destination": "https://api.yourstayo.com/api/payments/pay/:token"
    },
    {
      "source": "/pay/:token",
      "destination": "https://api.yourstayo.com/api/payments/pay/:token"
    },
    {
      "source": "/h/:slug",
      "destination": "https://api.yourstayo.com/api/discover/share/:slug"
    },
    {
      "source": "/hostels",
      "destination": "https://api.yourstayo.com/hostels"
    },
    {
      "source": "/hostels/:slug",
      "destination": "https://api.yourstayo.com/hostels/:slug"
    },
    {
      "source": "/hostels-in/:path*",
      "destination": "https://api.yourstayo.com/hostels-in/:path*"
    },
    {
      "source": "/hostels-near/:path*",
      "destination": "https://api.yourstayo.com/hostels-near/:path*"
    },
    {
      "source": "/_next/:path*",
      "destination": "https://api.yourstayo.com/_next/:path*"
    },
    {
      "source": "/sitemap.xml",
      "destination": "https://api.yourstayo.com/sitemap.xml"
    },
    {
      "source": "/sitemaps/:shard",
      "destination": "https://api.yourstayo.com/sitemaps/:shard"
    },
    {
      "source": "/robots.txt",
      "destination": "https://api.yourstayo.com/robots.txt"
    },
    {
      "source": "/((?!api/)(?!.*\\.[a-zA-Z0-9]{1,5}$).*)",
      "destination": "/index.html"
    }
  ],
  "redirects": [
    {
      "source": "/hostels/:slug/",
      "destination": "/hostels/:slug",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.yourstayo.com"
        }
      ],
      "destination": "https://yourstayo.com/:path*",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; media-src 'self' https://cdn.sanity.io https://media.w3.org https://www.w3schools.com; script-src 'self' 'unsafe-inline' https://accounts.google.com https://checkout.razorpay.com https://clerk.yourstayo.com; script-src-elem 'self' 'unsafe-inline' https://accounts.google.com https://checkout.razorpay.com https://clerk.yourstayo.com; worker-src 'self' blob:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; img-src 'self' data: blob: https:; font-src 'self' data: https://fonts.gstatic.com; connect-src 'self' https://stayo-backend-stayo-devs-projects.vercel.app https://api.yourstayo.com https://*.supabase.co wss://*.supabase.co https://ik.imagekit.io https://upload.imagekit.io https://accounts.google.com https://*.api.sanity.io https://api.razorpay.com https://clerk.yourstayo.com https://api.clerk.com; frame-src https://accounts.google.com https://www.google.com https://api.razorpay.com; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=(self \"https://api.razorpay.com\")"
        }
      ]
    },
    {
      "source": "/owner",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/owner/:path*",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
